# PostgreSQL
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/hse_rag

# Embeddings
# Модель НЕ задаётся здесь: эмбеддинги считает только embedding-svc, и авторитетным
# является имя модели, которое вернул сам сервис. Здесь объявляется лишь ожидаемая
# размерность — она сверяется при запуске и с embedding-svc, и с колонкой в БД.
EMBEDDING_SVC_URL=http://embedding-svc:8000
EMBEDDING_DIM=1024
# Батч при обращении к embedding-svc. Должен быть меньше MAX_TEXTS_PER_REQUEST там.
EMBED_BATCH_SIZE=64
EMBED_REQUEST_TIMEOUT_SEC=120
EMBED_STARTUP_RETRIES=30
EMBED_STARTUP_RETRY_WAIT_SEC=5

# Межсервисная аутентификация (должна совпадать с TRUSTED_SERVICE_TOKENS у embedding-svc)
SERVICE_NAME=ingest-worker
SERVICE_TOKEN=super-secret-token-for-ingest-worker
INTERNAL_AUTH_HEADER_NAME=X-Service-Token
INTERNAL_SERVICE_NAME_HEADER=X-Service-Name

# Chunking
CHUNK_SIZE=512
CHUNK_MIN_TOKENS=50
CHUNK_OVERLAP_TOKENS=32

# S3 / MinIO
# Required only when document_files.storage_backend is s3/minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
