DATABASE_URL=postgresql+asyncpg://admin:password@postgres:5432/hse_rag

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

EMBEDDER_NAME=mixedbread-ai/mxbai-embed-large-v1
# Optional: path to xlsx metadata file inside container
# Example: /app/data/metadata.xlsx
# METADATA_XLSX=

# Optional: if the project reads files from S3 / MinIO in parsers
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1
S3_SECURE=false

# Optional: if Google credentials are used
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_DRIVE_FOLDER_ID=
EMBEDDING_SERVICE_URL=http://embedding-svc:8000/embed
SERVICE_NAME=ingest-worker
SERVICE_TOKEN=super-secret-token-for-ingest-worker
INTERNAL_AUTH_ENABLED=true
INTERNAL_AUTH_HEADER_NAME=X-Service-Token
INTERNAL_SERVICE_NAME_HEADER=X-Service-Name