# PostgreSQL
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/hse_rag

# Embeddings
# Модель НЕ задаётся здесь: эмбеддинги считает только embedding-svc, и авторитетным
# является имя модели, которое вернул сам сервис. Здесь объявляется лишь ожидаемая
# размерность — она сверяется при запуске и с embedding-svc, и с колонкой в БД.
EMBEDDING_SVC_URL=http://embedding-svc:8000
EMBEDDING_DIM=1024
# Батч при обращении к embedding-svc. Должен быть меньше MAX_TEXTS_PER_REQUEST там.
EMBED_BATCH_SIZE=64
EMBED_REQUEST_TIMEOUT_SEC=120
EMBED_STARTUP_RETRIES=30
EMBED_STARTUP_RETRY_WAIT_SEC=5

# Очередь и повторы (колонки и триггеры — main/infra/db/migrations/006_ingest_queue.sql)
# Неудачная попытка возвращает документ в pending с паузой: INGEST_RETRY_BASE_SEC,
# удваивается до INGEST_RETRY_MAX_SEC. После INGEST_MAX_ATTEMPTS попыток — failed.
INGEST_MAX_ATTEMPTS=5
INGEST_RETRY_BASE_SEC=30
INGEST_RETRY_MAX_SEC=3600
# processing дольше этого срока считается брошенным (воркер упал посреди документа).
INGEST_PROCESSING_TIMEOUT_SEC=1800
# Задачи приходят через LISTEN/NOTIFY; канал должен совпадать с триггером в БД.
INGEST_NOTIFY_CHANNEL=ingest_jobs
# Страховочный опрос: при работающем LISTEN и при потерянном соединении.
INGEST_POLL_FALLBACK_SEC=60
INGEST_POLL_DEGRADED_SEC=5
INGEST_NO_FILE_GRACE_SEC=300

# Предел размера исходного файла; больше — документ сразу failed, без повторов.
MAX_FILE_SIZE_MB=50


# Chunking
CHUNK_SIZE=512
CHUNK_MIN_TOKENS=50
CHUNK_OVERLAP_TOKENS=32

# S3 / MinIO
# Required only when document_files.storage_backend is s3/minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
